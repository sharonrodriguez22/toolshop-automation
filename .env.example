# Environment variables required to run this test suite.
# Copy this file to .env before running the tests.

# Toolshop, the application under test.
UI_BASE_URL=https://practicesoftwaretesting.com
API_BASE_URL=https://api.practicesoftwaretesting.com

# Same API, shipped with intentional defects by the Toolshop project.
# Used to verify the suite actually fails when the application is broken.
API_BUGS_BASE_URL=https://api-with-bugs.practicesoftwaretesting.com

# Demo account seeded and publicly documented by the Toolshop project.
# These are not private credentials. See README for the other seeded accounts.
TEST_USER_EMAIL=customer@practicesoftwaretesting.com
TEST_USER_PASSWORD=welcome01