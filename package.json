{
  "name": "toolshop-automation",
  "version": "1.0.0",
  "description": "UI and API test automation framework built with Playwright and TypeScript, with CI on GitHub Actions",
  "license": "MIT",
  "author": "Sharon Rodríguez Liendo",
  "type": "commonjs",
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "api-testing",
    "e2e-testing",
    "qa"
  ],
  "scripts": {
    "test": "playwright test --project=ui-chromium --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:bugs": "playwright test --project=api-bugs",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharonrodriguez22/toolshop-automation.git"
  },
  "homepage": "https://github.com/sharonrodriguez22/toolshop-automation#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.1",
    "typescript": "^7.0.2"
  }
}
